DATABASE_URL=postgres://hoanxu:CHANGE_ME@127.0.0.1:5432/hoanxu?sslmode=disable
# Optional separate schema-owner connection, used only by migrations.
MIGRATION_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
PORT=8080
# Generate with: go run ./cmd/admin key
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
CHROME_PATH=
CHROME_PROFILE=private-data/chrome-profile
# Set false on a desktop to keep Affiliate open for manual login/verification.
# Restart the backend after changing this setting.
CHROME_HEADLESS=true
# Admin settings can apply encrypted saved cookies without restarting.
# Reuses this app's managed Chromium, not the personal Chrome profile.
PRIVATE_DIR=private-data/files
SHOPEE_ENABLED=false
SHOPEE_TRACKING_VERIFIED=false
SHOPEE_PUBLISHER=
# Only enable after capturing real responses and confirming the price units.
SHOPEE_SCHEMA_VERIFIED=false
SHOPEE_PRICE_SCALE=0
TEST_DATABASE_URL=postgres://hoanxu:CHANGE_ME@127.0.0.1:5432/hoanxu_test?sslmode=disable
