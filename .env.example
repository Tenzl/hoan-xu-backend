APP_ENV=development
DATABASE_URL=postgres://hoanxu:CHANGE_ME@127.0.0.1:5432/hoanxu_local?sslmode=disable
PROXY_SIGNING_KEY=
# Optional separate schema-owner connection, used only by migrations.
MIGRATION_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=8080
# Generate with: go run ./cmd/admin key
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Shopee and Chrome are configured in admin, backed by the database.
# REMOTE_BROWSER_ORIGIN is the backend origin, not EC2 or Vercel.
REMOTE_BROWSER_ENABLED=false
REMOTE_BROWSER_ORIGIN=
REMOTE_BROWSER_UPSTREAM=http://127.0.0.1:6080
REMOTE_BROWSER_BRIDGE_PASSWORD=
# The production Docker entrypoint supervises SSH. Direct go run ignores these.
CHROME_SSH_TUNNEL_ENABLED=true
CHROME_SSH_HOST=
CHROME_SSH_USER=chrome-tunnel
CHROME_SSH_PORT=22
CHROME_SSH_PRIVATE_KEY=
CHROME_SSH_KNOWN_HOSTS=
DISPLAY=:99
PRIVATE_DIR=private-data/files
TEST_DATABASE_URL=postgres://hoanxu:CHANGE_ME@127.0.0.1:5432/hoanxu_test?sslmode=disable
